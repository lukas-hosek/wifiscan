#
# Script mode (cmake -P): compiles the vendored JetBrains Mono TTFs into a C++ source so the GUI needs no font
# files at runtime. GCC 13 has no #embed, and a string literal would trip -Woverlength-strings under -Wpedantic,
# so each font becomes a byte array.
#
# Inputs: FONT_DIR (third_party/fonts/JetBrainsMono), OUTPUT (the .cpp to write).

if(NOT FONT_DIR OR NOT OUTPUT)
	message(FATAL_ERROR "EmbedFonts.cmake needs -DFONT_DIR=... and -DOUTPUT=...")
endif()

# Accessor name (declared in src/gui/EmbeddedFonts.hpp) -> TTF file
set(fonts
	"JetBrainsMonoRegularTtf=JetBrainsMono-Regular.ttf"
	"JetBrainsMonoSemiBoldTtf=JetBrainsMono-SemiBold.ttf"
	"JetBrainsMonoItalicTtf=JetBrainsMono-Italic.ttf"
)

set(source "// SPDX-License-Identifier: MIT\n")
string(APPEND source "// wifiscan - copyright (c) 2026 Lukas Hosek\n")
string(APPEND source "// Generated by cmake/EmbedFonts.cmake from third_party/fonts/JetBrainsMono (SIL OFL 1.1). Do not edit.\n")
string(APPEND source "#include \"gui/EmbeddedFonts.hpp\"\n\nnamespace gui::fonts\n{\n")

foreach(entry IN LISTS fonts)
	string(REPLACE "=" ";" pair "${entry}")
	list(GET pair 0 accessor)
	list(GET pair 1 file)

	file(READ "${FONT_DIR}/${file}" hex HEX)
	string(LENGTH "${hex}" hexLength)
	math(EXPR byteCount "${hexLength} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")

	string(APPEND source "\nnamespace\n{\nconstexpr unsigned char k${accessor}[${byteCount}] = {\n${bytes}\n};\n} // namespace\n\n")
	string(APPEND source "std::span<const unsigned char> ${accessor}()\n{\n\treturn k${accessor};\n}\n")
endforeach()

string(APPEND source "\n} // namespace gui::fonts\n")

# Write through a temp file so an interrupted run never leaves a truncated source behind
file(WRITE "${OUTPUT}.tmp" "${source}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
